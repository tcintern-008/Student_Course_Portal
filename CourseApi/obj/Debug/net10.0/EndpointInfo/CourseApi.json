          "id": {
            "type": "integer",
            "format": "int32"
          },
          "studentId": {
            "type": "integer",
            "format": "int32"
          },
          "student": {
            "$ref": "#/components/schemas/Student"
          },
          "courseId": {
            "type": "integer",
            "format": "int32"
          },
          "course": {
