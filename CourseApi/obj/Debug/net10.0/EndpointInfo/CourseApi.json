        "required": [
          "duration",
          "instructorId",
          "level",
          "slug",
          "summary",
          "title"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "slug": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "title": {
            "maxLength": 150,
            "minLength": 2,
            "type": "string"
          },
          "instructorId": {
            "type": "integer",
            "format": "int32"
          },
          "instructor": {
            "$ref": "#/components/schemas/Instructor"
          },
          "duration": {
            "minLength": 1,
            "type": "string"
          },
          "level": {
            "minLength": 1,
            "type": "string"
          },
          "summary": {
            "maxLength": 300,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "topics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseTopic"
            },
            "nullable": true
          },
          "enrollments": {
