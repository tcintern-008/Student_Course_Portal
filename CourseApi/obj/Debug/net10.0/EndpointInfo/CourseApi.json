            "type": "integer",
            "format": "int32"
          },
          "courseId": {
            "type": "integer",
            "format": "int32"
          },
          "course": {
            "$ref": "#/components/schemas/Course"
          },
          "text": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CourseUpsertDto": {
        "required": [
          "duration",
          "instructor",
          "level",
          "slug",
          "summary",
          "title"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 150,
            "minLength": 2,
            "type": "string"
          },
          "instructor": {
            "minLength": 1,
            "type": "string"
          },
          "duration": {
            "minLength": 1,
            "type": "string"
          },
          "level": {
            "minLength": 1,
            "type": "string"
          },
          "summary": {
            "maxLength": 300,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "topics": {
            "type": "array",
